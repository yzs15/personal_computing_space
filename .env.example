LOOM_SERVICE_NAME=observer
LOOM_DATABASE_URL=postgresql+asyncpg://loom:loom@observer-db:5432/loom_observer
LOOM_CODING_AGENT_BACKEND=codex
LOOM_CODEX_MODEL=deepseek-v4-flash
LOOM_CODEX_BASE_URL=http://host.docker.internal:8787
LOOM_CODEX_MODEL_CATALOG_PATH=../../.codex/model_catalog.json
CODEX_VERSION=0.151.0
LOOM_INTERNAL_API_SECRET_FILE=../secrets/internal_api_secret
LOOM_INTERNAL_API_SECRET=
LOOM_WORKSPACE_ID=workspace-default
LOOM_WORKSPACE_ROOT=/workspace
LOOM_ORCHESTRATOR_TIMEOUT_SECONDS=300
LOOM_OBSERVER_FORWARD_TIMEOUT_SECONDS=86400
